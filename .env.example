# ========================================================
# OmniAchievements Configuration
# ========================================================

# Port where OmniAchievements will be accessible
PORT=3001

# Master Gateway Password (Required for Web / External Access)
# Protects the app when opening it in a browser before profile selection.
MASTER_PASSWORD=YourStrongMasterPasswordHere

# Valve Steam Web API Key (Free)
# Get yours here: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# SteamGridDB API Key (Free)
# Used to fetch high-res 600x900 box art, hero banners, and logos
# Get yours here: https://www.steamgriddb.com/profile/preferences/api
STEAMGRIDDB_API_KEY=

# Secret token used for signing JWT sessions (change in production)
JWT_SECRET=replace_with_a_random_secure_32_character_string_here
