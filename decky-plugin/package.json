{
  "name": "omniachievements-decky",
  "version": "0.2.0",
  "description": "Decky Loader plugin for OmniAchievements",
  "scripts": {
    "build": "npx esbuild src/index.tsx --bundle --format=esm --external:react --external:react-dom --external:decky-frontend-lib --external:@decky/ui --external:@decky/api --target=es2020 --outfile=dist/index.js && cp dist/index.js ./index.js",
    "watch": "npx esbuild src/index.tsx --bundle --format=esm --external:react --external:react-dom --external:decky-frontend-lib --external:@decky/ui --external:@decky/api --target=es2020 --outfile=dist/index.js --watch"
  },
  "dependencies": {
    "@decky/ui": "^4.0.0",
    "decky-frontend-lib": "^4.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^24.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/react": "^18.0.0",
    "rollup": "^3.0.0",
    "typescript": "^5.0.0"
  }
}
